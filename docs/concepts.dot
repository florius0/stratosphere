digraph Concepts {
  graph [rankdir=LR, label="Stratosphere concepts — concepts.md is authoritative", labelloc=t];
  node [shape=box];
  C01 [label="C-01 Workspace tree\nUUID + sibling-unique name\nleaf wrapping transfers binding"];
  C02 [label="C-02 Display binding\nphysical / main / unbound\nactivation-scoped ancestor overrides"];
  C03 [label="C-03 Visible scope\nselected leaf per display\nunarchived active-project move preserves scope/focus"];
  C04 [label="C-04 Managed window/context\none leaf owner; one live context/app"];
  C05 [label="C-05 Lifecycle/presence\nhidden, closed, minimized, archive\nsealed archives; unarchive before interaction"];
  C06 [label="C-06 Leaf layout groups\none tiled + free overlays\ncentered placement; positional drag selects free\nfull-screen mode survives switching"];
  C07 [label="C-07 Integration\ndocumented fidelity, matching, state"];
  C08 [label="C-08 Current state/history\nselective restore + previews\nrestore original nodes/windows\nsemantic backups include history/Undo"];
  C09 [label="C-09 Operations/actions\ninternal preflight; purge consent\nonly conflicting side-effect steps wait"];
  C10 [label="C-10 WorkspaceOrder\npinned/MRU circular traversal"];
  C11 [label="C-11 Rail + overview\nthin clients"];
  C12 [label="C-12 Notification view\nseparate persisted content"];
  C13 [label="C-13 Recovery/compatibility\nwatchdogs + tested backend"];
  C01 -> C01 [label="contains workspace children"];
  C01 -> C04 [label="leaves own"];
  C01 -> C02 [label="may bind"];
  C02 -> C03 [label="resolves placement"];
  C01 -> C03 [label="eligible subtree"];
  C01 -> C10 [label="ordered traversal"];
  C01 -> C05 [label="recursive lifecycle"];
  C05 -> C08 [label="purge preserves retained references"];
  C01 -> C06 [label="leaf property"];
  C06 -> C04 [label="references IDs; arranges"];
  C07 -> C04 [label="captures/restores context"];
  C07 -> C08 [label="versioned payloads"];
  C08 -> C04 [label="window-only restore keeps leaf owner"];
  C09 -> C01 [label="mutates with preflight"];
  C09 -> C08 [label="retains before-state"];
  C09 -> C07 [label="routine actions accept documented limits"];
  C11 -> C09 [label="public RPC actions"];
  C11 -> C03 [label="presents"];
  C11 -> C08 [label="timeline/preview"];
  C12 -> C04 [label="attributes"];
  C11 -> C12 [label="displays"];
  C13 -> C04 [label="recovers surviving geometry"];
}
